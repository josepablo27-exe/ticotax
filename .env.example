# =============================================================================
# TicoTax SaaS — .env.example
# Épica TICOTAX-100 | Sprint 1 | Historia TICOTAX-102
#
# Exigido explícitamente por el Plan Maestro v4.0, PARTE 1, Factor III (Config):
#   "100% en variables de entorno. .env.example documentado.
#    AWS SecretsManager en producción"
#
# USO:  cp .env.example .env   &&   docker compose up -d
# El archivo .env NUNCA se commitea (PARTE 4.3 — Secrets Management).
# =============================================================================

# --- PostgreSQL 15 (PARTE 2.1) ----------------------------------------------
POSTGRES_DB=ticotax
POSTGRES_USER=ticotax
POSTGRES_PASSWORD=cambiar_en_local_no_usar_en_prod
POSTGRES_PORT_HOST=5432

# --- PgBouncer 1.22 (PARTE 2.1 / 2.2) ---------------------------------------
PGBOUNCER_PORT_HOST=5432

# --- Redis 7 (PARTE 2.1) ----------------------------------------------------
REDIS_PORT_HOST=6379

# --- Valores tomados del ConfigMap ticotax-config (PARTE 8.2) ---------------
LOG_LEVEL=info
CR_TIMEZONE=America/Costa_Rica
BCRYPT_ROUNDS=12
JWT_EXPIRY=900
REFRESH_TOKEN_EXPIRY=604800

# --- Secret local. En K8s viene de AWS Secrets Manager (PARTE 8.2) ----------
# Generar con: openssl rand -base64 48
JWT_SECRET=generar_con_openssl_rand_base64_48

# --- OWASP A10 SSRF: allowlist del BCCR (PARTE 4.1) -------------------------
BCCR_ALLOWED_HOST=gee.bccr.fi.cr

# --- Frontend React + Vite (TICOTAX-203) ------------------------------------
# ⚠ Puerto 5173 y prefijo VITE_ no están en el Plan Maestro: son el default de
#   Vite. El path /api/v1 sí está documentado (PARTE 12.1, Tema 5).
# ⚠ NUNCA poner secretos en variables VITE_: quedan expuestas en el bundle.
FRONTEND_PORT_HOST=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1
